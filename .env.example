# XRPScan API
XRPSCAN_METRICS_URL=https://api.xrpscan.com/api/v1/metrics/metric

# Telegram 本地服务
TELEGRAM_SERVICE_URL=http://localhost:3000
API_KEY=your-secret-api-key
TELEGRAM_ALERT_CHAT_ID=-5363003109
TELEGRAM_DAILY_CHAT_ID=-5535517204
# 兼容旧配置：如果上面两个变量未设置，会回退到 CHAT_ID
CHAT_ID=your-telegram-chat-id

# 监控配置
PAYMENTS_THRESHOLD=2000000
CHECK_INTERVAL_MS=14400000
REPORT_INTERVAL_DAYS=3
REPORT_HOUR=16
REPORT_MINUTE=38
STATE_FILE=.monitor-state.json

# Aspecta Top Gainer / Top Loser 监控
ASPECTA_ENABLED=true
ASPECTA_API_URL=https://aspecta.ai/api/hermes/trading/arena-popular-assets
ASPECTA_KLINE_URL=https://aspecta.ai/api/hermes/trading/k-line
ASPECTA_TRADING_CONFIG_ID=1
ASPECTA_ORDER_BY=-popularity
ASPECTA_URL_NAME=TradingAttention
ASPECTA_MONITORED_ASSETS=Ostium,DAPPOS
ASPECTA_CHECK_INTERVAL_MS=300000
ASPECTA_CHANGE_THRESHOLD_PERCENT=10
ASPECTA_REPEAT_PRICE_DELTA_PERCENT=5
ASPECTA_REPEAT_ALERT_WINDOW_HOURS=24
ASPECTA_REPEAT_PRICE_DELTA_PERCENT_AFTER_10_ALERTS=10
ASPECTA_REPEAT_PRICE_DELTA_PERCENT_AFTER_20_ALERTS=20
ASPECTA_PRICE_DECIMALS=18
